# Copy this file to .env and adjust to your dataset. Never commit .env.
# Place your dataset CSV under data/ and point DATA_PATH at it.
DATA_PATH=data/dataset.csv
TARGET_COLUMN=target
PROBLEM_TYPE=classification   # classification | regression
# HW1 split date and Random Forest parameters live in params.yaml.

# Silo object storage (copy to .env and replace both credential placeholders).
SILO_ACCESS_KEY=replace-with-a-unique-access-key
SILO_SECRET_KEY=replace-with-a-long-unique-secret
SILO_API_PORT=5510
SILO_CONSOLE_PORT=5511
DVC_BUCKET=dvc-storage
MLFLOW_BUCKET=mlflow-artifacts

# PostgreSQL credentials. Use a URL-safe password (letters/digits) because
# the server passes it in a PostgreSQL connection URI.
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=replace-with-a-unique-alphanumeric-password
POSTGRES_DB=mlflowdb
POSTGRES_HOST_PORT=5532

# MLflow client and server
MLFLOW_PORT=5500
MLFLOW_TRACKING_URI=http://127.0.0.1:5500
MLFLOW_EXPERIMENT_NAME=bike-demand-hw1
