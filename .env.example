# Copy this file to .env and adjust to your dataset. Never commit .env.
# Place your dataset CSV under data/ and point DATA_PATH at it.
DATA_PATH=data/dataset.csv
TARGET_COLUMN=target
PROBLEM_TYPE=classification   # classification | regression
TEST_SIZE=0.25
RANDOM_SEED=42
MAX_ITER=1000

# Silo object storage (copy to .env and replace both credential placeholders).
SILO_ACCESS_KEY=replace-with-a-unique-access-key
SILO_SECRET_KEY=replace-with-a-long-unique-secret
SILO_API_PORT=5510
SILO_CONSOLE_PORT=5511
DVC_BUCKET=dvc-storage
